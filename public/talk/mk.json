{"language":"mk","example":false,"narrator_languages":["pt"],"cast":{"vera":{"name":"Вера Стојановска (госпоѓа Стојановска)","voice":"mk-f2","register":"formal"},"marko":{"name":"Марко","voice":"mk-m","register":"informal"},"ana":{"name":"Ана","voice":"mk-f","register":"formal"},"dragan":{"name":"Драган","voice":"mk-m2","register":"formal"}},"voices":[{"id":"nar-pt","role":"narrator","lang":"pt","tts":"piper:pt_BR-cadu-medium"},{"id":"mk-m","role":"character","lang":"mk","gender":"m","tts":"piper:bg_BG-dimitar-medium+mk-phonemes"},{"id":"mk-m2","role":"character","lang":"mk","gender":"m","tts":"piper:bg_BG-dimitar-medium+mk-phonemes","pitch":0.9},{"id":"mk-f","role":"character","lang":"mk","gender":"f","tts":"piper:bg_BG-dimitar-medium+mk-phonemes","pitch":1.25},{"id":"mk-f2","role":"character","lang":"mk","gender":"f","tts":"piper:bg_BG-dimitar-medium+mk-phonemes","pitch":1.35}],"protagonist":{"f":"mk-f","m":"mk-m"},"items":[{"id":"dobar-den","text":"Добар ден","meaning":{"pt":"Bom dia / boa tarde"},"register":"formal"},{"id":"izvinete","text":"Извинете","meaning":{"pt":"Com licença / desculpe (formal)"},"register":"formal"},{"id":"ne-razbiram","text":"Не разбирам","meaning":{"pt":"Não entendo"}},{"id":"zboruvate-angliski","text":"Зборувате ли англиски?","meaning":{"pt":"A senhora fala inglês?"},"register":"formal"},{"id":"da","text":"Да","meaning":{"pt":"Sim"}},{"id":"od-brazil","text":"Од Бразил сум","meaning":{"pt":"Sou do Brasil"}},{"id":"malku","text":"Малку","meaning":{"pt":"Um pouco"}},{"id":"jas-sum","text":"Јас сум","meaning":{"pt":"Eu sou"}},{"id":"novata-stanarka","text":"новата станарка","meaning":{"pt":"a nova inquilina"}},{"id":"povelete","text":"Повелете","meaning":{"pt":"Aqui está / pode entrar / sirva-se (formal)"},"register":"formal"},{"id":"ova-e","text":"Ова е","meaning":{"pt":"Este é / isto é"}},{"id":"klucot","text":"клучот","meaning":{"pt":"a chave"}},{"id":"blagodaram","text":"Благодарам","meaning":{"pt":"Obrigada / obrigado"}},{"id":"gospogjo","text":"госпоѓо Стојановска","meaning":{"pt":"senhora Stojanovska (chamando-a)"},"register":"formal"},{"id":"nema-zosto","text":"Нема зошто","meaning":{"pt":"De nada"}},{"id":"dobredojdovte","text":"Добредојдовте","meaning":{"pt":"Bem-vinda / bem-vindos (formal)"},"register":"formal"},{"id":"vlezete","text":"Влезете","meaning":{"pt":"Entre / entrem (formal)"},"register":"formal"},{"id":"stanot","text":"станот","meaning":{"pt":"o apartamento"}},{"id":"ubav-e","text":"Убав е","meaning":{"pt":"É bonito"}},{"id":"kade-e","text":"Каде е…?","meaning":{"pt":"Onde fica…? / Onde está…?"}},{"id":"kujnata","text":"кујната","meaning":{"pt":"a cozinha"}},{"id":"tuka","text":"тука","meaning":{"pt":"aqui"}},{"id":"tamu","text":"таму","meaning":{"pt":"ali / lá"}},{"id":"a-sto","text":"А …?","meaning":{"pt":"E o/a …? (perguntando por outra coisa)"}},{"id":"banjata","text":"бањата","meaning":{"pt":"o banheiro"}},{"id":"sobata","text":"собата","meaning":{"pt":"o quarto"}},{"id":"golema","text":"голема","meaning":{"pt":"grande (com palavra feminina: собата)"}},{"id":"mnogu","text":"многу","meaning":{"pt":"muito"}},{"id":"prozorecot","text":"прозорецот","meaning":{"pt":"a janela"}},{"id":"mal","text":"мал","meaning":{"pt":"pequeno (com palavra masculina: прозорецот)"}},{"id":"dobro","text":"Добро","meaning":{"pt":"Bem / está bem / bom"}},{"id":"dolu","text":"долу","meaning":{"pt":"embaixo / lá embaixo"}},{"id":"papuci","text":"влечки","meaning":{"pt":"chinelos (de usar em casa)"}}],"units":[{"id":"A1-01","level":"A1","number":1,"protagonist":"f","title":{"pt":"A senhoria"},"situation":{"pt":"Você acabou de chegar ao prédio em Skopje, no bairro de Karpoš. A senhoria, a senhora Stojanovska, abre a porta."},"learn_lessons":["a1-sum","a1-pronouns"],"culture":"Calling the landlady by her first name","new_items":[{"id":"dobar-den","text":"Добар ден","meaning":{"pt":"Bom dia / boa tarde"},"register":"formal"},{"id":"izvinete","text":"Извинете","meaning":{"pt":"Com licença / desculpe (formal)"},"register":"formal"},{"id":"ne-razbiram","text":"Не разбирам","meaning":{"pt":"Não entendo"}},{"id":"zboruvate-angliski","text":"Зборувате ли англиски?","meaning":{"pt":"A senhora fala inglês?"},"register":"formal"},{"id":"da","text":"Да","meaning":{"pt":"Sim"}},{"id":"od-brazil","text":"Од Бразил сум","meaning":{"pt":"Sou do Brasil"}},{"id":"malku","text":"Малку","meaning":{"pt":"Um pouco"}},{"id":"jas-sum","text":"Јас сум","meaning":{"pt":"Eu sou"}},{"id":"novata-stanarka","text":"новата станарка","meaning":{"pt":"a nova inquilina"}},{"id":"povelete","text":"Повелете","meaning":{"pt":"Aqui está / pode entrar / sirva-se (formal)"},"register":"formal"},{"id":"ova-e","text":"Ова е","meaning":{"pt":"Este é / isto é"}},{"id":"klucot","text":"клучот","meaning":{"pt":"a chave"}},{"id":"blagodaram","text":"Благодарам","meaning":{"pt":"Obrigada / obrigado"}},{"id":"gospogjo","text":"госпоѓо Стојановска","meaning":{"pt":"senhora Stojanovska (chamando-a)"},"register":"formal"},{"id":"nema-zosto","text":"Нема зошто","meaning":{"pt":"De nada"}},{"id":"dobredojdovte","text":"Добредојдовте","meaning":{"pt":"Bem-vinda / bem-vindos (formal)"},"register":"formal"}],"reviews":[],"steps":[{"type":"narrator","text":{"pt":"Você acabou de chegar à Macedônia do Norte. Escute a conversa com a senhoria. Ainda não precisa entender."}},{"type":"dialogue","lines":[{"speaker":"protagonist","text":"Добар ден!","meaning":{"pt":"Boa tarde!"}},{"speaker":"vera","text":"Добар ден. Вие сте новата станарка?","meaning":{"pt":"Boa tarde. A senhora é a nova inquilina?"}},{"speaker":"protagonist","text":"Извинете, не разбирам.","meaning":{"pt":"Desculpe, não entendo."}},{"speaker":"vera","text":"Новата станарка? Од Бразил?","meaning":{"pt":"A nova inquilina? Do Brasil?"}},{"speaker":"protagonist","text":"Да, од Бразил сум. Зборувате ли англиски?","meaning":{"pt":"Sim, sou do Brasil. A senhora fala inglês?"}},{"speaker":"vera","text":"Малку. Јас сум Вера Стојановска.","meaning":{"pt":"Um pouco. Eu sou Vera Stojanovska."}},{"speaker":"vera","text":"Повелете, ова е клучот.","meaning":{"pt":"Aqui está, esta é a chave."}},{"speaker":"protagonist","text":"Благодарам, госпоѓо Стојановска!","meaning":{"pt":"Obrigada, senhora Stojanovska!"}},{"speaker":"vera","text":"Нема зошто. Добредојдовте во Скопје!","meaning":{"pt":"De nada. Bem-vinda a Skopje!"}}]},{"type":"narrator","text":{"pt":"Para cumprimentar alguém que você não conhece, diga 'Добар ден'. Escute."}},{"type":"line","speaker":"vera","item":"dobar-den"},{"type":"prompt","ask":{"pt":"Cumprimente a senhoria."},"answer":{"speaker":"protagonist","text":"Добар ден!"},"items":["dobar-den"]},{"type":"narrator","text":{"pt":"'Извинете' é 'desculpe' ou 'com licença', na forma educada. Repare: a força cai em 'ВИ'."}},{"type":"buildup","item":"izvinete","parts":["-нете","-винете","Извинете"]},{"type":"prompt","ask":{"pt":"Peça licença para falar com ela."},"answer":{"speaker":"protagonist","text":"Извинете!"},"items":["izvinete"]},{"type":"line","speaker":"vera","item":"ne-razbiram"},{"type":"prompt","ask":{"pt":"Diga que você não entende."},"answer":{"speaker":"protagonist","text":"Не разбирам."},"items":["ne-razbiram"]},{"type":"prompt","ask":{"pt":"Peça desculpas e diga que não entende."},"answer":{"speaker":"protagonist","text":"Извинете, не разбирам."},"items":["izvinete","ne-razbiram"]},{"type":"narrator","text":{"pt":"Ela pergunta se você é do Brasil. 'Сум' é 'sou'; ele vem depois: 'од Бразил сум', 'do Brasil sou'."}},{"type":"prompt","ask":{"pt":"Diga que é do Brasil."},"answer":{"speaker":"protagonist","text":"Од Бразил сум."},"items":["od-brazil"]},{"type":"prompt","ask":{"pt":"Responda 'sim, sou do Brasil'."},"answer":{"speaker":"protagonist","text":"Да, од Бразил сум."},"items":["da","od-brazil"]},{"type":"narrator","text":{"pt":"Com uma senhora mais velha que você não conhece, use 'Вие', o tratamento educado. Pergunte se ela fala inglês."}},{"type":"buildup","item":"zboruvate-angliski","parts":["англиски?","ли англиски?","Зборувате ли англиски?"]},{"type":"prompt","ask":{"pt":"Pergunte: a senhora fala inglês?"},"answer":{"speaker":"protagonist","text":"Зборувате ли англиски?"},"items":["zboruvate-angliski"]},{"type":"line","speaker":"vera","item":"malku"},{"type":"prompt","ask":{"pt":"Ela fala inglês só um pouco. Como ela disse 'um pouco'?"},"answer":{"speaker":"protagonist","text":"Малку."},"items":["malku"]},{"type":"narrator","text":{"pt":"Para se apresentar: 'Јас сум' e o seu nome. Ela diz: 'Јас сум Вера Стојановска'."}},{"type":"prompt","ask":{"pt":"Diga 'eu sou do Brasil', começando por 'eu sou'."},"answer":{"speaker":"protagonist","text":"Јас сум од Бразил."},"items":["jas-sum"]},{"type":"prompt","ask":{"pt":"Diga que você é a nova inquilina."},"answer":{"speaker":"protagonist","text":"Јас сум новата станарка."},"items":["jas-sum","novata-stanarka"]},{"type":"narrator","text":{"pt":"Ela entrega a chave: 'Повелете, ова е клучот'. 'Повелете' serve para oferecer qualquer coisa, e para convidar a entrar."}},{"type":"line","speaker":"vera","item":"povelete"},{"type":"prompt","ask":{"pt":"Mostre a chave: 'esta é a chave'."},"answer":{"speaker":"protagonist","text":"Ова е клучот."},"items":["ova-e","klucot"]},{"type":"prompt","ask":{"pt":"Agradeça."},"answer":{"speaker":"protagonist","text":"Благодарам!"},"items":["blagodaram"]},{"type":"narrator","text":{"pt":"Não a chame de Vera: use 'госпоѓо' e o sobrenome. Ao chamar alguém, 'госпоѓа' vira 'госпоѓо'."}},{"type":"buildup","item":"gospogjo","parts":["-новска","Стојановска","госпоѓо Стојановска"]},{"type":"prompt","ask":{"pt":"Agradeça, chamando-a pelo sobrenome."},"answer":{"speaker":"protagonist","text":"Благодарам, госпоѓо Стојановска!"},"items":["blagodaram","gospogjo"]},{"type":"line","speaker":"vera","item":"nema-zosto"},{"type":"prompt","ask":{"pt":"Alguém lhe agradece. Responda 'de nada'."},"answer":{"speaker":"protagonist","text":"Нема зошто."},"items":["nema-zosto"]},{"type":"line","speaker":"vera","item":"dobredojdovte"},{"type":"prompt","ask":{"pt":"Como ela disse 'bem-vinda'?"},"answer":{"speaker":"protagonist","text":"Добредојдовте!"},"items":["dobredojdovte"]},{"type":"prompt","ask":{"pt":"Ela ofereceu a chave com uma palavra. Qual?"},"answer":{"speaker":"protagonist","text":"Повелете."},"items":["povelete"]},{"type":"prompt","ask":{"pt":"Cumprimente de novo e pergunte se ela fala inglês."},"answer":{"speaker":"protagonist","text":"Добар ден! Зборувате ли англиски?"},"items":["dobar-den","zboruvate-angliski"]},{"type":"prompt","ask":{"pt":"Diga: desculpe, não entendo, eu sou do Brasil."},"answer":{"speaker":"protagonist","text":"Извинете, не разбирам. Јас сум од Бразил."},"items":["izvinete","ne-razbiram","jas-sum"]},{"type":"prompt","ask":{"pt":"Ela diz 'bem-vinda'. Agradeça, chamando-a pelo sobrenome."},"answer":{"speaker":"protagonist","text":"Благодарам, госпоѓо Стојановска!"},"items":["blagodaram","gospogjo"]},{"type":"prompt","ask":{"pt":"Ela fala inglês? Responda por ela: 'sim, um pouco'."},"answer":{"speaker":"protagonist","text":"Да, малку."},"items":["da","malku"]},{"type":"prompt","ask":{"pt":"Ofereça a chave a um vizinho, com educação: 'aqui está, esta é a chave'."},"answer":{"speaker":"protagonist","text":"Повелете, ова е клучот."},"items":["povelete","ova-e","klucot"]},{"type":"prompt","ask":{"pt":"Ela pergunta de novo se você é a nova inquilina. Responda 'sim, eu sou a nova inquilina'."},"answer":{"speaker":"protagonist","text":"Да, јас сум новата станарка."},"items":["da","jas-sum","novata-stanarka"]},{"type":"prompt","ask":{"pt":"Um amigo chega do Brasil. Dê as boas-vindas a ele e aos pais dele, na forma educada."},"answer":{"speaker":"protagonist","text":"Добредојдовте!"},"items":["dobredojdovte"]},{"type":"prompt","ask":{"pt":"Eles agradecem. Responda 'de nada'."},"answer":{"speaker":"protagonist","text":"Нема зошто."},"items":["nema-zosto"]},{"type":"narrator","text":{"pt":"Escute a conversa outra vez. Agora você entende."}},{"type":"dialogue","again":true},{"type":"selfcheck"}]},{"id":"A1-02","level":"A1","number":2,"protagonist":"m","title":{"pt":"O apartamento"},"situation":{"pt":"A senhora Stojanovska mostra o apartamento: a cozinha, o banheiro, o quarto."},"learn_lessons":["a1-article","a1-demonstratives"],"culture":"Shoes off at the door","new_items":[{"id":"vlezete","text":"Влезете","meaning":{"pt":"Entre / entrem (formal)"},"register":"formal"},{"id":"stanot","text":"станот","meaning":{"pt":"o apartamento"}},{"id":"ubav-e","text":"Убав е","meaning":{"pt":"É bonito"}},{"id":"kade-e","text":"Каде е…?","meaning":{"pt":"Onde fica…? / Onde está…?"}},{"id":"kujnata","text":"кујната","meaning":{"pt":"a cozinha"}},{"id":"tuka","text":"тука","meaning":{"pt":"aqui"}},{"id":"tamu","text":"таму","meaning":{"pt":"ali / lá"}},{"id":"a-sto","text":"А …?","meaning":{"pt":"E o/a …? (perguntando por outra coisa)"}},{"id":"banjata","text":"бањата","meaning":{"pt":"o banheiro"}},{"id":"sobata","text":"собата","meaning":{"pt":"o quarto"}},{"id":"golema","text":"голема","meaning":{"pt":"grande (com palavra feminina: собата)"}},{"id":"mnogu","text":"многу","meaning":{"pt":"muito"}},{"id":"prozorecot","text":"прозорецот","meaning":{"pt":"a janela"}},{"id":"mal","text":"мал","meaning":{"pt":"pequeno (com palavra masculina: прозорецот)"}},{"id":"dobro","text":"Добро","meaning":{"pt":"Bem / está bem / bom"}},{"id":"dolu","text":"долу","meaning":{"pt":"embaixo / lá embaixo"}},{"id":"papuci","text":"влечки","meaning":{"pt":"chinelos (de usar em casa)"}}],"reviews":[{"item":"dobar-den","from":"A1-01"},{"item":"izvinete","from":"A1-01"},{"item":"ne-razbiram","from":"A1-01"},{"item":"zboruvate-angliski","from":"A1-01"},{"item":"da","from":"A1-01"},{"item":"od-brazil","from":"A1-01"},{"item":"malku","from":"A1-01"},{"item":"jas-sum","from":"A1-01"},{"item":"novata-stanarka","from":"A1-01"},{"item":"povelete","from":"A1-01"},{"item":"ova-e","from":"A1-01"},{"item":"klucot","from":"A1-01"},{"item":"blagodaram","from":"A1-01"},{"item":"gospogjo","from":"A1-01"},{"item":"nema-zosto","from":"A1-01"},{"item":"dobredojdovte","from":"A1-01"}],"steps":[{"type":"narrator","text":{"pt":"No dia seguinte, a senhora Stojanovska mostra o apartamento. Escute; ainda não precisa entender."}},{"type":"dialogue","lines":[{"speaker":"vera","text":"Повелете, влезете. Ова е станот.","meaning":{"pt":"Por favor, entre. Este é o apartamento."}},{"speaker":"protagonist","text":"Убав е! Каде е кујната?","meaning":{"pt":"É bonito! Onde fica a cozinha?"}},{"speaker":"vera","text":"Кујната е тука.","meaning":{"pt":"A cozinha é aqui."}},{"speaker":"protagonist","text":"А бањата?","meaning":{"pt":"E o banheiro?"}},{"speaker":"vera","text":"Бањата е таму. Собата е многу голема.","meaning":{"pt":"O banheiro é ali. O quarto é muito grande."}},{"speaker":"protagonist","text":"Да, голема е. А прозорецот?","meaning":{"pt":"Sim, é grande. E a janela?"}},{"speaker":"vera","text":"Прозорецот е мал, но убав.","meaning":{"pt":"A janela é pequena, mas bonita."}},{"speaker":"vera","text":"Повелете, влечки.","meaning":{"pt":"Aqui estão uns chinelos."}},{"speaker":"protagonist","text":"Добро. Благодарам многу, госпоѓо Стојановска!","meaning":{"pt":"Está bem. Muito obrigado, senhora Stojanovska!"}},{"speaker":"vera","text":"Нема зошто. Јас сум долу.","meaning":{"pt":"De nada. Eu fico lá embaixo."}}]},{"type":"narrator","text":{"pt":"Na Macedônia, em casa, as pessoas tiram os sapatos na porta e usam chinelos. Ela vai oferecer um par."}},{"type":"line","speaker":"vera","item":"vlezete"},{"type":"prompt","ask":{"pt":"Ela diz 'entre'. Como ela disse?"},"answer":{"speaker":"protagonist","text":"Влезете."},"items":["vlezete"]},{"type":"prompt","review":true,"ask":{"pt":"Cumprimente-a primeiro, com educação."},"answer":{"speaker":"protagonist","text":"Добар ден, госпоѓо Стојановска!"},"items":["dobar-den","gospogjo"]},{"type":"prompt","ask":{"pt":"Ela mostra o apartamento. Diga: este é o apartamento."},"answer":{"speaker":"protagonist","text":"Ова е станот."},"items":["ova-e","stanot"]},{"type":"prompt","ask":{"pt":"Diga que é bonito."},"answer":{"speaker":"protagonist","text":"Убав е!"},"items":["ubav-e"]},{"type":"narrator","text":{"pt":"Para perguntar onde fica algo: 'Каде е' e a coisa. 'Кујната' é 'a cozinha': o 'a' do português vem no fim, '-та'."}},{"type":"buildup","item":"kujnata","parts":["-та","-јната","кујната"]},{"type":"prompt","ask":{"pt":"Pergunte onde fica a cozinha."},"answer":{"speaker":"protagonist","text":"Каде е кујната?"},"items":["kade-e","kujnata"]},{"type":"line","speaker":"vera","item":"tuka"},{"type":"prompt","ask":{"pt":"A cozinha é aqui. Diga isso."},"answer":{"speaker":"protagonist","text":"Кујната е тука."},"items":["kujnata","tuka"]},{"type":"narrator","text":{"pt":"Para perguntar 'e o …?', basta 'А' e a coisa: 'А бањата?'"}},{"type":"prompt","ask":{"pt":"Pergunte: e o banheiro?"},"answer":{"speaker":"protagonist","text":"А бањата?"},"items":["a-sto","banjata"]},{"type":"line","speaker":"vera","item":"tamu"},{"type":"prompt","ask":{"pt":"O banheiro é ali. Diga isso."},"answer":{"speaker":"protagonist","text":"Бањата е таму."},"items":["banjata","tamu"]},{"type":"prompt","ask":{"pt":"Pergunte onde fica o banheiro."},"answer":{"speaker":"protagonist","text":"Каде е бањата?"},"items":["kade-e","banjata"]},{"type":"narrator","text":{"pt":"'Собата' é 'o quarto'; a palavra é feminina, então 'grande' é 'голема'. 'Многу' é 'muito'."}},{"type":"prompt","ask":{"pt":"Diga: o quarto é grande."},"answer":{"speaker":"protagonist","text":"Собата е голема."},"items":["sobata","golema"]},{"type":"prompt","ask":{"pt":"Agora: o quarto é muito grande."},"answer":{"speaker":"protagonist","text":"Собата е многу голема."},"items":["sobata","mnogu","golema"]},{"type":"narrator","text":{"pt":"'Прозорецот' é 'a janela'; em macedônio a palavra é masculina, e 'pequeno' é 'мал'."}},{"type":"buildup","item":"prozorecot","parts":["-цот","-зорецот","прозорецот"]},{"type":"prompt","ask":{"pt":"Pergunte: e a 