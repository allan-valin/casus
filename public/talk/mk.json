answer":{"speaker":"protagonist","text":"Повелете, ова е клучот."},"items":["povelete","ova-e","klucot"]},{"type":"prompt","ask":{"pt":"Ela pergunta de novo se você é a nova inquilina. Responda 'sim, eu sou a nova inquilina'."},"answer":{"speaker":"protagonist","text":"Да, јас сум новата станарка."},"items":["da","jas-sum","novata-stanarka"]},{"type":"prompt","ask":{"pt":"Um amigo chega do Brasil. Dê as boas-vindas a ele e aos pais dele, na forma educada."},"answer":{"speaker":"protagonist","text":"Добредојдовте!"},"items":["dobredojdovte"]},{"type":"prompt","ask":{"pt":"Eles agradecem. Responda 'de nada'."},"answer":{"speaker":"protagonist","text":"Нема зошто."},"items":["nema-zosto"]},{"type":"narrator","text":{"pt":"Escute a conversa outra vez. Agora você entende."}},{"type":"dialogue","again":true},{"type":"selfcheck"}]}]}